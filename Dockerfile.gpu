# Sapheneia Forecast API — GPU accelerated (TimesFM 2.0 / Chronos)
#
# Same layout as Dockerfile.forecast, but on a CUDA base with GPU wheels:
#   - nvidia/cuda runtime base (driver on host supplies the kernel module)
#   - torch from the cu121 index
#   - MODEL_VARIANT pin + non-root user, matching the CPU image's guards
#
# Build args:
#   MODEL_NAME: chronos | timesfm20 | all (default: all)
#   MODEL_PORT: container port (default: 8000)
#
# Run requirements (see docker-compose.yml `forecast-timesfm-gpu` service):
#   NVIDIA driver on host + CDI spec generated:
#     nvidia-ctk cdi generate --output=/etc/cdi/nvidia.yaml
#   podman >= 5 honors CDI through compose; on podman 4.x pass the device
#   explicitly (podman run --device nvidia.com/gpu=all) or use podman-compose.

FROM docker.io/nvidia/cuda:12.1.1-runtime-ubuntu22.04

# Build arguments
ARG MODEL_NAME=all
ARG MODEL_PORT=8000

ENV MODEL_NAME=${MODEL_NAME}
ENV MODEL_PORT=${MODEL_PORT}
ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1

LABEL description="Sapheneia Forecasting API (GPU) - Model: ${MODEL_NAME}"

WORKDIR /app

# Install system dependencies (python3.11 + curl for healthchecks/uv)
RUN apt-get update && apt-get install -y \
    curl \
    git \
    python3.11 \
    python3.11-venv \
    && rm -rf /var/lib/apt/lists/*

# Map python to python3.11
RUN ln -s /usr/bin/python3.11 /usr/bin/python

# Install uv package manager
ENV UV_HOME=/usr/local/bin
RUN curl -LsSf https://astral.sh/uv/install.sh | sh && \
    mv /root/.cargo/bin/uv /usr/local/bin/uv 2>/dev/null || \
    mv /root/.local/bin/uv /usr/local/bin/uv 2>/dev/null || true

RUN which uv && uv --version

# Copy project files. §4.3: forecast is a leaf service — shared/ ships (it holds
# the contracts and registry), orchestration/ must never be copied into it.
COPY pyproject.toml ./
COPY forecast/ ./forecast/
COPY shared/ ./shared/

# Base deps first (torch from PyPI here is CPU/cu-default; the per-model step
# below re-pins torch to the cu121 index so both orders converge on CUDA builds)
RUN uv pip install --system --no-cache -e ".[forecasting]"

# Model-specific deps, torch pinned to the cu121 index
RUN if [ "$MODEL_NAME" = "timesfm20" ] || [ "$MODEL_NAME" = "all" ]; then \
        echo "Installing TimesFM GPU dependencies..." && \
        uv pip install --system --no-cache torch --extra-index-url https://download.pytorch.org/whl/cu121; \
    fi

RUN if [ "$MODEL_NAME" = "chronos" ] || [ "$MODEL_NAME" = "all" ]; then \
        echo "Installing Chronos GPU dependencies..." && \
        uv pip install --system --no-cache torch git+https://github.com/amazon-science/chronos-forecasting.git --extra-index-url https://download.pytorch.org/whl/cu121; \
    fi

# Create necessary directories
RUN mkdir -p \
    forecast/models/timesfm20/local \
    forecast/models/chronos/local \
    data/uploads \
    logs

# Run as an unprivileged user, same as the CPU image. Bind-mounted host dirs
# (./logs, model cache) must be writable by uid 1000.
RUN useradd --create-home --uid 1000 sapheneia \
    && chown -R sapheneia:sapheneia /app
USER sapheneia

EXPOSE ${MODEL_PORT}

HEALTHCHECK --interval=30s --timeout=10s --start-period=120s --retries=3 \
    CMD curl -f http://localhost:${MODEL_PORT}/health || exit 1

CMD ["uvicorn", "forecast.main:app", "--host", "0.0.0.0", "--port", "8000"]
