# =============================================================================
# Sapheneia v2 — environment template
# =============================================================================
# Copy to .env and fill in the secrets. The default values let the local
# stack start in development mode but are NOT safe for any shared host.
# =============================================================================

# --- Compose profile ---
COMPOSE_PROFILES=cpu
LOG_LEVEL=INFO
ENVIRONMENT=development

# --- TimescaleDB (Postgres + Timescale extension) ---
TIMESCALEDB_HOST=localhost
TIMESCALEDB_PORT=5432
TIMESCALEDB_USER=sapheneia
TIMESCALEDB_PASSWORD=sapheneia
TIMESCALEDB_DB=sapheneia

# --- Service ports (host side) ---
FORECAST_PORT=12700
DATA_API_PORT=12701
METRICS_PORT=12702
SAPHENEIA_MCP_PORT=12703
ORCHESTRATOR_PORT=12704
TRADING_API_PORT=12132

# --- Per-model forecast container ports ---
CHRONOS_T5_TINY_PORT=12710
CHRONOS_T5_MINI_PORT=12711
CHRONOS_T5_SMALL_PORT=12712
CHRONOS_T5_BASE_PORT=12713
CHRONOS_T5_LARGE_PORT=12714
TIMESFM_2_0_PORT=12721

# --- Bearer tokens (CHANGE IN PRODUCTION) ---
# NOTE: keep comments on their OWN LINE in this section.
# `KEY=` followed by an inline `# comment` parses the comment text as the
# value, which silently ENABLES auth with a password that is published in this
# repository — the opposite of the intended "empty disables auth".

# forecast service
API_SECRET_KEY=change_me_in_production_abc123
TRADING_API_KEY=change_me_trading_key_must_be_32_chars_or_more
# empty disables auth (intra-cluster default)
METRICS_API_KEY=
# empty disables auth
DATA_API_KEY=
# empty disables auth
ORCHESTRATOR_API_KEY=
# The single agent -> MCP token. The SSE transport REFUSES TO START without
# it, because this process holds every downstream service key. To run it open
# anyway on an isolated single-user host, set
# SAPHENEIA_MCP_ALLOW_UNAUTHENTICATED_SSE=true.
SAPHENEIA_MCP_TOKEN=
SAPHENEIA_MCP_ALLOW_UNAUTHENTICATED_SSE=false

# --- Forecast model loading ---
DEVICE=cpu                                                  # cpu | cuda:0 | mps
MODELS_CACHE_PATH=./.models_cache                           # host path; mounted into containers as /models_cache
TIMESFM20_DEFAULT_CHECKPOINT=google/timesfm-2.0-500m-pytorch
UVICORN_WORKERS=1                                           # KEEP AT 1 — forecast hard-fails otherwise

# --- Orchestrator concurrency caps ---
# parallel runs across the matrix
ORCHESTRATOR_MAX_CONCURRENT_RUNS=4
# parallel inference calls against the same model
ORCHESTRATOR_MAX_PER_MODEL=2

# --- Orchestrator heartbeat / reconciler ---
# Seconds between heartbeat writes while a run is in flight.
ORCHESTRATOR_HEARTBEAT_INTERVAL=30
# A run is considered stale after this long without a heartbeat. MUST stay
# comfortably above ORCHESTRATOR_FORECAST_TIMEOUT, or the reconciler will fail
# runs that are simply waiting on a slow model.
ORCHESTRATOR_HEARTBEAT_STALE_AFTER=900
# Single orchestrator instance: reclaim orphaned runs from previous processes.
# Set false if you ever run more than one orchestrator against this database.
ORCHESTRATOR_RECONCILE_ALL_OWNERS=true

# --- Container resource limits ---
# Defaults target the single-GB10 deployment. Override on smaller dev machines
# (a limit above the host's available memory will fail to start the container).
DB_CPUS=2
DB_MEM_LIMIT=4G
SERVICE_CPUS=2
SERVICE_MEM_LIMIT=2G
FORECAST_SMALL_CPUS=2
FORECAST_SMALL_MEM_LIMIT=6G
FORECAST_CPUS=4
FORECAST_MEM_LIMIT=16G
FORECAST_LARGE_CPUS=6
FORECAST_LARGE_MEM_LIMIT=24G
